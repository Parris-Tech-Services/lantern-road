    "coordinate_system": {
      "storage": "odd-r offset",
      "implementation_fields": [
        "q",
        "r"
      ],
      "note": "Existing game code converts odd-r offset q/r to cube coordinates for distance. Do not reinterpret persisted q/r as pure axial coordinates.",
      "q_range": [
        0,
        8
      ],
      "r_range": [
        0,
        7
      ]
    },
    "human_grid": {
      "columns": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I"
      ],
      "rows": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "formula": "grid_ref = columns[q] + String(r + 1)",
      "visual_note": "Odd-numbered storage rows (r = 1,3,5,7) are rendered half a hex to the right, matching the existing pointy-top odd-r layout."
    },
    "atlas_projection": {
      "orientation": "pointy-top",
      "offset_layout": "odd-r",
      "logical_canvas": {
        "width": 1200,
        "height": 900,
        "aspect_ratio": "4:3"
      },
      "hex_size": 65,
      "center_formula": {
        "x": "65 * sqrt(3) * (q + 0.5 * (r & 1)) + 104",
        "y": "65 * 1.5 * r + 110.5"
      },
      "scaling_rule": "The logical canvas may scale and pan/zoom, but the q/r-to-logical-coordinate formula is stable. Gameplay hit-testing uses q/r geometry, never painted pixels."
    }
  },
